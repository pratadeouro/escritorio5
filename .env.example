# Porta do Servidor Node.js (padrão 3000; no VPS ex.: PORT=5005)
PORT=

# Modo de Ambiente do Sistema ('homologacao' | 'producao')
APP_ENVIRONMENT=homologacao
VITE_APP_ENVIRONMENT=homologacao

# Fonte de Dados Única ('supabase' | 'sheets')
DATA_SOURCE=supabase
VITE_DATA_SOURCE=supabase

# Google OAuth Client ID (Global para todos os escritórios)
VITE_GOOGLE_CLIENT_ID=

# Google Sheets Configuration (somente quando DATA_SOURCE=sheets)
SPREADSHEET_ID=
VITE_SPREADSHEET_ID=
SCRIPT_URL=
VITE_SCRIPT_URL=

# Datajud API Configuration
PDPJ_API_TOKEN=

# Automação de E-mails / Cron e Fallback SMTP Global (Servidor Node.js)
CRON_SECRET=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Supabase Server & Database Configuration
SUPABASE_URL=
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
SECRET_KEY_BASE=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=

# Vite Client-side Supabase Configuration
VITE_SUPABASE_URL=
VITE_ANON_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
